{% assign repo_url = include.repository | split: '/' %}
{% assign repo_owner = repo_url[0] %}
{% assign repo_name = repo_url[1] %}

{% if site.data.repositories.github_users contains repo_owner %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo-card p-3 mb-2" data-repo="{{ include.repository }}">
  <a href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer" class="repo-card-link">
    <div class="repo-card-title">
      <i class="fa-regular fa-bookmark me-1"></i>
      {% if show_owner %}<span class="repo-card-owner">{{ repo_owner }}/</span>{% endif %}<span class="repo-card-name">{{ repo_name }}</span>
    </div>
    <p class="repo-card-desc" data-field="description"></p>
    <div class="repo-card-meta">
      <span class="repo-card-lang" data-field="language"></span>
      <span><i class="fa-regular fa-star"></i> <span data-field="stargazers_count">—</span></span>
      <span><i class="fa-solid fa-code-fork"></i> <span data-field="forks_count">—</span></span>
    </div>
  </a>
</div>
