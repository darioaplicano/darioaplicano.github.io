<div class="user-card p-3 mb-3" data-user="{{ include.username }}">
  <a href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer" class="user-card-link">
    <img class="user-card-avatar" src="https://github.com/{{ include.username }}.png?size=200" alt="{{ include.username }}" loading="lazy" width="96" height="96">
    <div class="user-card-name" data-field="name">{{ include.username }}</div>
    <div class="user-card-login">@{{ include.username }}</div>
    <p class="user-card-bio" data-field="bio"></p>
    <div class="user-card-meta">
      <span><i class="fa-regular fa-folder-open"></i> <span data-field="public_repos">—</span> repos</span>
      <span><i class="fa-regular fa-user"></i> <span data-field="followers">—</span> seguidores</span>
    </div>
  </a>
</div>
